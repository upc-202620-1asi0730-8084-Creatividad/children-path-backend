@ChildrenPath.Platform_HostAddress = http://localhost:5178

### Get Fleet
GET {{ChildrenPath.Platform_HostAddress}}/api/v1/fleet
Accept: application/json

###

### Get All Companies
GET {{ChildrenPath.Platform_HostAddress}}/api/v1/companies
Accept: application/json

###

### Get Company By ID
GET {{ChildrenPath.Platform_HostAddress}}/api/v1/companies/1
Accept: application/json

###

### Create Company
POST {{ChildrenPath.Platform_HostAddress}}/api/v1/companies
Content-Type: application/json

{
  "legalName": "Transportes Escolares del Perú S.A.C.",
  "commercialName": "TransEscolar S.A.C.",
  "ruc": "20601234567",
  "status": "active",
  "plan": "Enterprise Fleet",
  "planLimitVehicles": 30,
  "planLimitStudents": 1800,
  "adminName": "Carlos Mendoza",
  "adminEmail": "cmendoza@transescolar.pe",
  "phone": "+51 987 654 321",
  "address": "Av. Javier Prado Este 2450, San Borja, Lima",
  "operatingDistricts": ["San Borja", "Surco", "La Molina", "Miraflores", "San Isidro"],
  "verified": true,
  "licenseExpiration": "2028-11-05T00:00:00Z"
}

###

### Get Company Management Dashboard (Frontend View)
GET {{ChildrenPath.Platform_HostAddress}}/api/v1/company-management
Accept: application/json

###

### Update Compliance Item Status
PATCH {{ChildrenPath.Platform_HostAddress}}/api/v1/company-management/compliance/2/status
Content-Type: application/json

{
  "status": "completed"
}

###

### Get all Students (kebab-case route)
GET {{ChildrenPath.Platform_HostAddress}}/api/v1/student-records
Accept: application/json

###

### Get all Students (frontend-compatible route)
GET {{ChildrenPath.Platform_HostAddress}}/api/v1/studentRecords
Accept: application/json

###

### Get Student Summary
GET {{ChildrenPath.Platform_HostAddress}}/api/v1/student-summary
Accept: application/json

###

### Get Student Reviews
GET {{ChildrenPath.Platform_HostAddress}}/api/v1/student-reviews
Accept: application/json

###

### Get recent Student Activities
GET {{ChildrenPath.Platform_HostAddress}}/api/v1/student-activities?limit=20
Accept: application/json

###

### Create Student
POST {{ChildrenPath.Platform_HostAddress}}/api/v1/student-records
Content-Type: application/json

{
  "firstName": "Lucía",
  "lastName": "Vargas",
  "grade": "4th Grade",
  "school": "Lima Norte School",
  "guardianName": "Rosa Vargas",
  "guardianPhone": "+51 900 111 222",
  "guardianEmail": "rosa.vargas@example.com",
  "emergencyContact": "+51 900 111 223",
  "routeName": "North School Route",
  "pickupPoint": "Calle Pino 42",
  "pickupWindow": "06:45 - 06:55",
  "status": "active"
}

###

### Update Student
PUT {{ChildrenPath.Platform_HostAddress}}/api/v1/students/1
Content-Type: application/json

{
  "firstName": "Lucía",
  "lastName": "Vargas",
  "grade": "5th Grade",
  "school": "Lima Norte School",
  "guardianName": "Rosa Vargas",
  "guardianPhone": "+51 900 111 222",
  "guardianEmail": "rosa.vargas@example.com",
  "emergencyContact": "+51 900 111 223",
  "routeName": "North School Route",
  "pickupPoint": "Calle Pino 42",
  "pickupWindow": "06:45 - 06:55",
  "status": "active"
}

###

### Delete Student
DELETE {{ChildrenPath.Platform_HostAddress}}/api/v1/students/1

###

### Get all Drivers
GET {{ChildrenPath.Platform_HostAddress}}/api/v1/drivers
Accept: application/json

###

### Get Driver Summary (frontend-compatible route)
GET {{ChildrenPath.Platform_HostAddress}}/api/v1/driverSummary
Accept: application/json

###

### Get Driver Reviews
GET {{ChildrenPath.Platform_HostAddress}}/api/v1/driverReviews
Accept: application/json

###

### Get Driver Shifts / Recent Activity
GET {{ChildrenPath.Platform_HostAddress}}/api/v1/driverShifts?limit=20
Accept: application/json

###

### Create Driver
POST {{ChildrenPath.Platform_HostAddress}}/api/v1/drivers
Content-Type: application/json

{
  "fullName": "Elena Castillo",
  "phone": "+51 987 654 320",
  "email": "elena.castillo@example.com",
  "licenseNumber": "AIIb-458722",
  "licenseClass": "A-IIb",
  "licenseExpiresAt": "2027-04-15T00:00:00Z",
